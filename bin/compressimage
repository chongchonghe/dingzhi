#!/usr/bin/env bash
#
# compressimage — batch image compressor for scientific publication figures.
#
# Compresses PNG, JPEG, and WebP images using format-specific, quality-first tools:
#   PNG  → pngquant --quality=85-95 --output compressed/fig.png fig.png
#   JPEG → jpegoptim --max=92 --strip-all --dest compressed/ fig.jpg
#            (fallback: djpeg fig.jpg | cjpeg -quality 92 -optimize -progressive > compressed/fig.jpg)
#   WebP → cwebp -q 90 fig.webp -o compressed/fig.webp
#
# When --scale/--width/--height is given, the image is first resized via
# ImageMagick (magick -resize), sips (macOS), or ffmpeg into a temp file,
# then the compressor runs on that temp file.
#
# Optionally resizes images before compression (--scale, --width, --height).
# Outputs go to ./compressed/ by default; existing files are skipped unless -f.
# Parallel processing via -j N.
#
# Examples:
#   compressimage                          # compress all *.png/jpg/jpeg/webp in cwd
#   compressimage fig1.png fig2.jpg        # specific files
#   compressimage *.png                    # all PNGs
#   compressimage --width 1200 *.png       # resize to 1200px wide, then compress
#   compressimage --scale 0.5 *.jpg        # half size, then compress
#   compressimage --height 800 fig*.webp   # resize to 800px tall
#   compressimage -j 8 *.png *.jpg         # 8 parallel workers
#   compressimage -o out/ -f *.png         # output to out/, overwrite existing
#   compressimage --jpeg-quality 95 *.jpg  # higher JPEG quality
#
# Usage: compressimage [--scale F | --width W | --height H]
#                      [-o DIR] [-j N] [-f]
#                      [--png-quality LOW-HIGH] [--jpeg-quality Q] [--webp-quality Q]
#                      [--] [PATTERN|FILE ...]
set -euo pipefail

usage() {
  cat <<'EOF'
Batch image compressor (PNG, JPEG, WebP) for publication figures.
Usage: compressimage [--scale F | --width W | --height H]
                     [-o DIR] [-j N] [-f]
                     [--png-quality LOW-HIGH] [--jpeg-quality Q] [--webp-quality Q]
                     [--] [PATTERN|FILE ...]

Quality defaults (visually lossless for print-quality figures):
  PNG:  pngquant --quality=85-95
  JPEG: jpegoptim --max=92  (fallback: cjpeg/djpeg -quality 92)
  WebP: cwebp -q 90

Requires (per format): pngquant, jpegoptim (or cjpeg+djpeg), cwebp.
Resizing needs: magick, convert (ImageMagick), sips (macOS), or ffmpeg.

Options:
  --scale F              Uniform scale factor (e.g. 0.5 → half size). Not combinable with --width/--height.
  --width W              Scale to W px wide, keeping aspect ratio.
  --height H             Scale to H px tall, keeping aspect ratio.
  -o, --out-dir DIR      Output directory (default: compressed)
  -j, --jobs N           Parallel workers; 0 = unlimited (default: 0)
  -f, --force            Overwrite existing outputs (default: skip)
  --png-quality LOW-HIGH pngquant --quality range (default: 85-95)
  --jpeg-quality Q       JPEG quality 1-100 (default: 92)
  --webp-quality Q       WebP quality 0-100 (default: 90)
  -h, --help             Show this help

Patterns default to *.png *.jpg *.jpeg *.webp (case-insensitive) when none are given.
Existing outputs are skipped unless -f is passed.
EOF
}

pick_resizer() {
  RESIZER=""
  if [[ -z "${WIDTH:-}" && -z "${HEIGHT:-}" && -z "${SCALE:-}" ]]; then
    return 0
  fi
  if command -v magick >/dev/null 2>&1; then RESIZER=magick; return 0; fi
  if command -v convert >/dev/null 2>&1; then RESIZER=convert; return 0; fi
  if command -v sips >/dev/null 2>&1; then RESIZER=sips; return 0; fi
  if command -v ffmpeg >/dev/null 2>&1; then RESIZER=ffmpeg; return 0; fi
  echo "compressimage: scaling needs ImageMagick (magick or convert), macOS sips, or ffmpeg." >&2
  exit 1
}

resize_image() {
  local src=$1 dst=$2 pct iw ih nw nh
  if [[ -n "${SCALE:-}" ]]; then
    case "$RESIZER" in
      magick)
        pct=$(awk -v s="$SCALE" 'BEGIN{printf "%.16g", s*100}')
        magick "$src" -resize "${pct}%" "$dst"
        ;;
      convert)
        pct=$(awk -v s="$SCALE" 'BEGIN{printf "%.16g", s*100}')
        convert "$src" -resize "${pct}%" "$dst"
        ;;
      ffmpeg)
        ffmpeg -hide_banner -loglevel error -y -i "$src" \
          -vf "scale=iw*${SCALE}:ih*${SCALE}:flags=lanczos" -frames:v 1 "$dst"
        ;;
      sips)
        iw=$(sips -g pixelWidth "$src" 2>/dev/null | awk '/pixelWidth:/{print $2; exit}')
        ih=$(sips -g pixelHeight "$src" 2>/dev/null | awk '/pixelHeight:/{print $2; exit}')
        [[ -n "${iw:-}" && -n "${ih:-}" ]] || {
          echo "compressimage: could not read dimensions from: $src" >&2; return 1
        }
        nw=$(awk -v w="$iw" -v s="$SCALE" 'BEGIN{printf "%d", int(w*s+0.5)}')
        nh=$(awk -v h="$ih" -v s="$SCALE" 'BEGIN{printf "%d", int(h*s+0.5)}')
        if [[ "$nw" -lt 1 || "$nh" -lt 1 ]]; then
          echo "compressimage: scaled dimensions too small (--scale $SCALE)." >&2; return 1
        fi
        sips -z "$nh" "$nw" "$src" --out "$dst" >/dev/null
        ;;
      *)
        echo "compressimage: internal error: no resizer." >&2; return 1
        ;;
    esac
    return 0
  fi
  case "$RESIZER" in
    magick)
      if [[ -n "${WIDTH:-}" ]]; then magick "$src" -resize "${WIDTH}x" "$dst"
      else magick "$src" -resize "x${HEIGHT}" "$dst"
      fi
      ;;
    convert)
      if [[ -n "${WIDTH:-}" ]]; then convert "$src" -resize "${WIDTH}x" "$dst"
      else convert "$src" -resize "x${HEIGHT}" "$dst"
      fi
      ;;
    sips)
      if [[ -n "${WIDTH:-}" ]]; then sips --resampleWidth "$WIDTH" "$src" --out "$dst" >/dev/null
      else sips --resampleHeight "$HEIGHT" "$src" --out "$dst" >/dev/null
      fi
      ;;
    ffmpeg)
      local vf
      if [[ -n "${WIDTH:-}" ]]; then vf="scale=${WIDTH}:-1:flags=lanczos"
      else vf="scale=-1:${HEIGHT}:flags=lanczos"
      fi
      ffmpeg -hide_banner -loglevel error -y -i "$src" -vf "$vf" -frames:v 1 "$dst"
      ;;
    *)
      echo "compressimage: internal error: no resizer." >&2; return 1
      ;;
  esac
}

run_one() {
  local f=$1
  # src=$f cannot share the `local` with f=$1: within a single `local`, the
  # earlier assignment has not taken effect yet, so src would come out empty.
  local base out ext tmpdir=""
  local src=$f
  base=$(basename "$f")
  out="$OUTDIR/$base"
  ext=$(printf '%s' "${base##*.}" | tr '[:upper:]' '[:lower:]')

  if [[ "$FORCE" -eq 0 ]] && [[ -e "$out" ]]; then
    echo "compressimage: skip existing: $out" >&2
    return 0
  fi

  # Resize into a tmpdir/<basename> so that jpegoptim --dest sees the correct filename.
  if [[ -n "${WIDTH:-}" || -n "${HEIGHT:-}" || -n "${SCALE:-}" ]]; then
    tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/compressimage.XXXXXX")
    local tmp="$tmpdir/$base"
    if ! resize_image "$f" "$tmp"; then
      rm -rf "$tmpdir"
      return 1
    fi
    src=$tmp
  fi

  local ok=0
  case "$ext" in
    png)
      if ! command -v pngquant >/dev/null 2>&1; then
        echo "compressimage: pngquant not found. Install: brew install pngquant" >&2
        [[ -n "$tmpdir" ]] && rm -rf "$tmpdir"
        return 1
      fi
      local -a cmd=(pngquant --quality="$PNG_QUALITY")
      [[ "$FORCE" -eq 1 ]] && cmd+=(--force)
      cmd+=(--output "$out" "$src")
      "${cmd[@]}" && ok=1
      ;;
    jpg|jpeg)
      if command -v jpegoptim >/dev/null 2>&1; then
        # jpegoptim --dest writes <dest>/<basename-of-src>; src must have the right basename.
        # When resize created a tmpdir/base file, this is already correct.
        jpegoptim --max="$JPEG_QUALITY" --strip-all --quiet --dest "$OUTDIR" "$src" && ok=1
      elif command -v cjpeg >/dev/null 2>&1 && command -v djpeg >/dev/null 2>&1; then
        djpeg "$src" | cjpeg -quality "$JPEG_QUALITY" -optimize -progressive >"$out" && ok=1
      else
        echo "compressimage: no JPEG compressor found. Install: brew install jpegoptim" >&2
        [[ -n "$tmpdir" ]] && rm -rf "$tmpdir"
        return 1
      fi
      ;;
    webp)
      if ! command -v cwebp >/dev/null 2>&1; then
        echo "compressimage: cwebp not found. Install: brew install webp" >&2
        [[ -n "$tmpdir" ]] && rm -rf "$tmpdir"
        return 1
      fi
      cwebp -q "$WEBP_QUALITY" -quiet "$src" -o "$out" && ok=1
      ;;
    *)
      echo "compressimage: unsupported format: .$ext ($f)" >&2
      [[ -n "$tmpdir" ]] && rm -rf "$tmpdir"
      return 1
      ;;
  esac

  [[ -n "$tmpdir" ]] && rm -rf "$tmpdir"
  [[ "$ok" -eq 1 ]] || return 1
}

# ---- defaults ----
OUTDIR=compressed
JOBS=0
FORCE=0
WIDTH=""
HEIGHT=""
SCALE=""
RESIZER=""
PNG_QUALITY=85-95
JPEG_QUALITY=92
WEBP_QUALITY=90
patterns=()

# ---- argument parsing ----
while [[ $# -gt 0 ]]; do
  case "$1" in
    --scale)
      [[ $# -ge 2 ]] || { echo "compressimage: $1 needs an argument" >&2; exit 1; }
      [[ -z "${WIDTH}" && -z "${HEIGHT}" ]] || {
        echo "compressimage: use only one of --scale, --width, or --height." >&2; exit 1
      }
      SCALE=$2; shift 2
      ;;
    --width)
      [[ $# -ge 2 ]] || { echo "compressimage: $1 needs an argument" >&2; exit 1; }
      [[ -z "${HEIGHT}" ]] || { echo "compressimage: use only one of --width or --height." >&2; exit 1; }
      [[ -z "${SCALE:-}" ]] || { echo "compressimage: use only one of --scale, --width, or --height." >&2; exit 1; }
      WIDTH=$2; shift 2
      ;;
    --height)
      [[ $# -ge 2 ]] || { echo "compressimage: $1 needs an argument" >&2; exit 1; }
      [[ -z "${WIDTH}" ]] || { echo "compressimage: use only one of --width or --height." >&2; exit 1; }
      [[ -z "${SCALE:-}" ]] || { echo "compressimage: use only one of --scale, --width, or --height." >&2; exit 1; }
      HEIGHT=$2; shift 2
      ;;
    -o|--out-dir)
      [[ $# -ge 2 ]] || { echo "compressimage: $1 needs an argument" >&2; exit 1; }
      OUTDIR=$2; shift 2
      ;;
    -j|--jobs)
      [[ $# -ge 2 ]] || { echo "compressimage: $1 needs an argument" >&2; exit 1; }
      JOBS=$2; shift 2
      ;;
    -f|--force)
      FORCE=1; shift
      ;;
    --png-quality)
      [[ $# -ge 2 ]] || { echo "compressimage: $1 needs an argument" >&2; exit 1; }
      PNG_QUALITY=$2; shift 2
      ;;
    --jpeg-quality)
      [[ $# -ge 2 ]] || { echo "compressimage: $1 needs an argument" >&2; exit 1; }
      JPEG_QUALITY=$2; shift 2
      ;;
    --webp-quality)
      [[ $# -ge 2 ]] || { echo "compressimage: $1 needs an argument" >&2; exit 1; }
      WEBP_QUALITY=$2; shift 2
      ;;
    -h|--help)
      usage; exit 0
      ;;
    --)
      shift; patterns+=("$@"); break
      ;;
    -*)
      echo "compressimage: unknown option: $1" >&2; usage >&2; exit 1
      ;;
    *)
      patterns+=("$1"); shift
      ;;
  esac
done

# ---- validation ----
if [[ -n "$WIDTH" ]] && ! [[ "$WIDTH" =~ ^[1-9][0-9]*$ ]]; then
  echo "compressimage: --width must be a positive integer." >&2; exit 1
fi
if [[ -n "$HEIGHT" ]] && ! [[ "$HEIGHT" =~ ^[1-9][0-9]*$ ]]; then
  echo "compressimage: --height must be a positive integer." >&2; exit 1
fi
if [[ -n "${SCALE:-}" ]]; then
  if ! SCALE=$(awk -v s="$SCALE" 'BEGIN{if (s+0<=0) exit 1; printf "%.16g", s+0}'); then
    echo "compressimage: --scale must be a positive number." >&2; exit 1
  fi
fi
if ! [[ "$JOBS" =~ ^[0-9]+$ ]]; then
  echo "compressimage: -j must be a non-negative integer (got: $JOBS)" >&2; exit 1
fi
if ! [[ "$JPEG_QUALITY" =~ ^[1-9][0-9]*$ ]] || [[ "$JPEG_QUALITY" -gt 100 ]]; then
  echo "compressimage: --jpeg-quality must be 1-100." >&2; exit 1
fi
if ! [[ "$WEBP_QUALITY" =~ ^[0-9]+$ ]] || [[ "$WEBP_QUALITY" -gt 100 ]]; then
  echo "compressimage: --webp-quality must be 0-100." >&2; exit 1
fi

[[ ${#patterns[@]} -eq 0 ]] && patterns=('*.png' '*.jpg' '*.jpeg' '*.webp')

pick_resizer
mkdir -p "$OUTDIR"

# ---- expand patterns to file list ----
files=()
declare -a matches
shopt -s nullglob nocaseglob
for pat in "${patterns[@]}"; do
  if [[ -f "$pat" ]]; then
    files+=("$pat")
    continue
  fi
  # shellcheck disable=SC2206
  matches=( $pat )
  [[ ${#matches[@]} -eq 0 ]] && continue
  files+=("${matches[@]}")
done
shopt -u nullglob nocaseglob

if [[ ${#files[@]} -eq 0 ]]; then
  echo "compressimage: no matching image files." >&2; exit 1
fi

export OUTDIR FORCE WIDTH HEIGHT SCALE RESIZER PNG_QUALITY JPEG_QUALITY WEBP_QUALITY
export -f resize_image run_one

if [[ "$JOBS" -eq 0 ]]; then
  for f in "${files[@]}"; do
    run_one "$f" &
  done
  wait
else
  printf '%s\0' "${files[@]}" | xargs -0 -n1 -P"$JOBS" bash -c 'run_one "$1"' _
fi
